# ─── Secrets & Tokens Only ────────────────────────────────────────────────────
# Keep only sensitive keys here. All other config goes in src/config/framework.properties
OPENAI_API_KEY=your-openai-api-key-here

# ─── Real Device Cloud Testing ────────────────────────────────────────────────
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
LAMBDATEST_USERNAME=
LAMBDATEST_ACCESS_KEY=
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
# SAUCE_REGION=us-west-1   # Options: us-west-1, eu-central-1

# ─── Native App Testing (Appium) ─────────────────────────────────────────────
# Override Appium server URL (default: http://localhost:4723)
# APPIUM_SERVER_URL=http://localhost:4723
