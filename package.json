{
  "name": "playwright-bdd-framework",
  "version": "2.1.0",
  "description": "Playwright TypeScript BDD Framework for Web & API Automation",
  "scripts": {
    "test": "cucumber-js",
    "test:accessibility": "npx cucumber-js --profile accessibility",
    "test:mobile": "npx cucumber-js --profile mobile",
    "test:native": "npx cucumber-js --profile native",
    "test:native:android": "node src/utils/EnsureAppInstalled.js && npx cucumber-js --profile native --tags \"@native and @android\"",
    "test:native:ios": "npx cucumber-js --profile native --tags \"@native and @ios\"",
    "test:native:smoke": "node src/utils/EnsureAppInstalled.js && npx cucumber-js --profile native --tags \"@native and @smoke\"",
    "appium:start": "start /b appium > reports/logs/appium.log 2>&1",
    "test:native:local": "start /b appium > reports/logs/appium.log 2>&1 & ping 127.0.0.1 -n 5 > nul & node src/utils/EnsureAppInstalled.js && npx cucumber-js --profile native --tags \"@native and @android\"",
    "test:cross-browser": "npx ts-node src/core/CrossBrowserRunner.ts",
    "test:cross-browser:parallel": "set CROSS_BROWSER_PARALLEL=true && npx ts-node src/core/CrossBrowserRunner.ts",
    "test:chromium": "set CROSS_BROWSER_TARGET=chromium && npx cucumber-js --profile cross-browser",
    "test:firefox": "set CROSS_BROWSER_TARGET=firefox && npx cucumber-js --profile cross-browser",
    "test:webkit": "set CROSS_BROWSER_TARGET=webkit && npx cucumber-js --profile cross-browser",
    "report": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('reports','html');if(fs.existsSync(d))fs.rmSync(d,{recursive:true});fs.mkdirSync(p.join('reports','cucumber-json'),{recursive:true})\" && node src/utils/GenerateReport.js",
    "allure:generate": "node src/utils/AllureOpen.js generate",
    "allure:open": "node src/utils/AllureOpen.js open",
    "allure:serve": "node src/utils/AllureOpen.js serve",
    "allure:history": "node -e \"const fs=require('fs'),p=require('path');const dir='reports/allure-results';const runs=fs.readdirSync(dir).filter(f=>f.startsWith('run-')).sort().reverse();console.log('\\nAllure Report History ('+runs.length+' runs):\\n'+runs.map((r,i)=>'  '+(i+1)+'. '+r).join('\\n'));\"",
    "clean": "node -e \"const fs=require('fs');['reports','test-results'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true})})\""
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.3",
    "@cucumber/cucumber": "^10.3.2",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "ajv": "^8.16.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "multiple-cucumber-html-reporter": "^3.7.0",
    "openai": "^4.52.0",
    "playwright": "^1.60.0",
    "rm": "^0.1.8",
    "rmi": "^0.0.1",
    "sharp": "^0.33.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "allure-commandline": "^2.43.0",
    "browserstack-node-sdk": "^1.63.2",
    "fast-check": "^4.8.0",
    "get-port": "^5.1.1",
    "lighthouse": "^13.4.0",
    "playwright-lighthouse": "^4.0.0",
    "vitest": "^4.1.6"
  }
}
