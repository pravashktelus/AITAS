{
  "enabled": true,
  "name": "Run Unit Tests on Core Changes",
  "description": "Automatically runs Vitest unit tests when core engine files are modified to catch regressions in self-healing, cross-browser, accessibility, and other critical framework components.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/core/**/*.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest --run",
    "timeout": 60
  }
}