{
  "enabled": false,
  "name": "New Feature File Scaffolding Check",
  "description": "DISABLED \u2014 merged into validate-feature-files hook which uses fileEdited (fires on both create and edit). Having both caused duplicate agent roundtrips on feature file creation.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "features/**/*.feature"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Disabled - see validate-feature-files hook."
  }
}