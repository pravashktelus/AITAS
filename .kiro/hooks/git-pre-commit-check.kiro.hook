{
  "enabled": true,
  "name": "Git Pre-Commit Safety Check",
  "description": "FIXED: Changed from preToolUse on ALL shell commands (intercepted every terminal call) to userTriggered. Run manually before committing.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Perform git pre-commit safety check:\n1. Secrets scan: No OPENAI_API_KEY, BROWSERSTACK_ACCESS_KEY, passwords, or .env content in staged files\n2. Ignored files: No node_modules/, reports/, test-results/, .playwright-mcp/, *.log, .DS_Store\n3. Commit message: Must be meaningful (not just fix/update/wip)\n4. Branch safety: Warn if pushing to main/master\n5. Large files: Flag any file > 1MB\nReport any issues found."
  }
}