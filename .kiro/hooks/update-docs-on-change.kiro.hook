{
  "enabled": false,
  "name": "Update Docs on Source Change",
  "description": "When TypeScript source files, feature files, config files, or properties files are edited, asks the agent to update the README or docs to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.feature",
      "*.properties",
      "cucumber.yml",
      "package.json",
      "tsconfig.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if the README.md or any documentation in the project needs to be updated to stay in sync. If the change affects public APIs, configuration options, project structure, available commands, or feature capabilities, update the relevant documentation (README.md or files in a docs/ folder if one exists). If the change is purely internal implementation with no documentation impact, do nothing."
  }
}