{
  "enabled": true,
  "name": "Verify Implementation After Task",
  "description": "After a spec task is completed, runs TypeScript compilation and unit tests to verify the implementation is correct and doesn't introduce regressions.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit --pretty & npx vitest --run",
    "timeout": 90
  }
}