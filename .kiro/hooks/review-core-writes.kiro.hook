{
  "enabled": true,
  "name": "Review Core Engine Write Operations",
  "description": "FIXED: Changed from preToolUse on ALL writes (blocked every file write) to fileEdited on src/core only. Reviews core engine changes for framework pattern compliance.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/core/**/*.ts",
      "src/hooks/Hooks.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A core engine file was just modified. Please verify:\n1. Backward compatibility with existing step definitions\n2. New engines follow: class with constructor, injected via CustomWorld\n3. Imports use path aliases (@core/, @utils/, @config/, @steps/, @pages/)\n4. Error handling uses Logger pattern (Logger.info/warn/error)\n5. No circular dependencies introduced\nReport issues only if found."
  }
}