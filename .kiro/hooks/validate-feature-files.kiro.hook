{
  "enabled": true,
  "name": "Validate Feature File Syntax",
  "description": "When a .feature file is edited, validates Gherkin syntax, checks for undefined step definitions, verifies proper tag usage, and ensures page object references (PageName.ElementKey) have corresponding .properties entries.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.feature"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A Gherkin feature file was just modified. Please validate:\n\n1. Gherkin syntax correctness (proper Given/When/Then/And structure, valid scenario/feature declarations)\n2. Check that all referenced page object locators (e.g., 'TeleConnect.BtnNext') have corresponding entries in the matching .properties file under src/pages/properties/\n3. Verify tags are valid and follow project conventions (@web, @api, @mobile, @native, @accessibility, @a11y, @loadtest, @performance, @visual, @self-healing, @smoke, @e2e)\n4. Ensure data placeholders use correct syntax: ##FieldName for random data, {variableName} for DataStore, $$variableName for PersistentStore\n5. Report any issues found with specific line references and suggested fixes."
  }
}