{
  "enabled": true,
  "name": "Validate Feature File Syntax",
  "description": "When a .feature file is saved, performs a quick validation of Gherkin syntax, tags, locator references, and data placeholders. Reports issues only.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.feature"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A feature file was saved. Quickly validate and report ONLY actual issues:\n1. Gherkin syntax errors (malformed Given/When/Then, missing scenario keyword)\n2. Invalid tags (not in: @web @api @mobile @native @accessibility @a11y @loadtest @performance @visual @self-healing @smoke @e2e @regression)\n3. Wrong data placeholder syntax (## for random, {} for DataStore, } for PersistentStore)\n4. Any PageName.ElementKey references where the .properties file does not exist under src/pages/properties/\nIf everything looks correct, respond with a single line: Validation passed."
  }
}